# Environment Variables Template
# Copy this to .env and fill in your actual values
# Used by docker-compose.yml for production deployment

# ========================================
# DATABASE
# ========================================
DB_ROOT_PASSWORD=root
DB_USER=app_user
DB_PASSWORD=app_password
DB_NAME=employee_management

# ========================================
# JWT
# ========================================
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production

# ========================================
# URLS (For production)
# ========================================
FRONTEND_URL=http://localhost:3000
API_URL=http://backend:5000

# ========================================
# NODE ENVIRONMENT
# ========================================
NODE_ENV=production

# ========================================
# OPTIONAL REDIS (FUTURE ENABLEMENT)
# ========================================
# Uncomment only if you add Redis back to the architecture.
# REDIS_PASSWORD=
# REDIS_HOST=redis
# REDIS_PORT=6379

# ========================================
# DEPLOYMENT NOTES
# ========================================
# Local Development (Windows):
# - Don't use this file
# - Set environment variables in .env inside backend/ and frontend/
#
# Docker Deployment (Production):
# - Copy this to .env
# - Update JWT_SECRET with a strong random value
# - Update URLs to match your domain
# - Run: docker-compose up -d
# - Optional future setup: enable Redis blocks in this file and docker-compose.yml
